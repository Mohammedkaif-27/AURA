# ═══════════════════════════════════════════════════════════
# AURA — Environment Variables
# Copy this file to .env and fill in your actual values.
# ═══════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────
# "groq" (default) or "nvidia"
LLM_PROVIDER=groq

# Groq (primary — free tier available)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (fallback — free tier available)
# Only needed if LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Embeddings & Reranker (API-based via HuggingFace) ────
# Single API key for both embedding and reranking.
# Get a free token at https://huggingface.co/settings/tokens
HF_API_KEY=your-hf-api-token-here

# Embedding model (768-dim, called via HF feature-extraction endpoint)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Reranker model (called via HF text-classification endpoint)
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Supabase (create a new free project at supabase.com) ─
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── SMTP Email (for notifications) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SENDER_EMAIL=your-email@gmail.com

# ── Admin Authorization ──────────────────────────────────
# Comma-separated list of admin email addresses.
# Also supports Supabase user_metadata.is_admin=true flag.
ADMIN_EMAILS=admin@example.com

# Key required to hit the /admin/rebuild-collection endpoint
ADMIN_API_KEY=your-secure-random-string-here
ENABLE_REBUILD_ENDPOINT=false

# ── Chroma Cloud (Vector Database) ────────────────────────
# Find these in the Chroma Cloud dashboard -> Settings / API keys
CHROMA_API_KEY=your-chroma-api-key-here
CHROMA_TENANT=your-tenant-id-here
CHROMA_DATABASE=aura-manuals
# Server port (default: 8080)
# PORT=8080
